    {
      "name": "Statement cases",
      "item": [
        {
          "name": "Test 1 - 2020-06-14 10:00",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Applicable price\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.productId).to.eql(35455);",
                  "    pm.expect(body.brandId).to.eql(1);",
                  "    pm.expect(body.priceList).to.eql(1);",
                  "    pm.expect(body.price).to.eql(35.5);",
                  "    pm.expect(body.currency).to.eql(\"EUR\");",
                  "    pm.expect(body.startDate).to.eql(\"2020-06-14T00:00:00\");",
                  "    pm.expect(body.endDate).to.eql(\"2020-12-31T23:59:59\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prices?applicationDate=2020-06-14T10:00:00&productId=35455&brandId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
